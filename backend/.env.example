PORT=4000
CORS_ORIGIN=http://localhost:5173
MAX_FILE_SIZE_MB=5
SESSION_TTL_MINUTES=60
MAX_TEST_CASES=50

# Timeout for fetching a Swagger/OpenAPI document from a user-supplied URL.
URL_FETCH_TIMEOUT_MS=15000

# Required to enable test case generation (correction still works without these,
# falling back to deterministic-only fixes). Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=60000
GROQ_MAX_COMPLETION_TOKENS=2800
# Only supported by reasoning models (e.g. openai/gpt-oss-*). Leave unset for
# standard models like llama-3.3-70b-versatile.
GROQ_REASONING_EFFORT=low
GROQ_MAX_PATHS_PER_CHUNK=2
